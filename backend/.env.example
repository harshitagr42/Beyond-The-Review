# Server
PORT=8000
CORS_ORIGIN=http://localhost:3000

# Uploads
MAX_FILE_SIZE=104857600           # bytes (100 MB)
MIN_ROWS=10
MAX_ROWS=100000
REQUIRE_DATE_COLUMN=true

# Storage
DATA_DIR=./data_store
DATABASE_URL=sqlite:///./data_store/app.db
KEEP_RAW_UPLOADS=false            # true keeps uploaded files after the job (debug only)

# Jobs
JOB_RETENTION_DAYS=7
JOB_TIMEOUT_SECONDS=3600
# Number of spawn worker processes. Each loads the ML engine; raising this multiplies memory use.
WORKER_CONCURRENCY=1
QUEUE_MAX_SIZE=20

# Analytics
DASHBOARD_THEME_LIMIT=10
TREND_LOW_SAMPLE=10

# Optional; if set, every /api/v1/* request requires header X-API-Key
API_KEY=

LOG_LEVEL=INFO

# ML engine selection: local = FeedbackAnalysisPipeline (real models, requires ml-engine/)
#                       mock  = no torch / no models (for tests and UI development only)
ML_ENGINE=local
# Folder that contains src/ml/. Relative to the process cwd (backend/).
ML_ENGINE_PATH=../ml-engine
# After models have been downloaded once, set this to forbid any network access:
# HF_HUB_OFFLINE=1
