# =============================================================================
# Feedback & Review Analyzer - configuration
# Copy to .env and edit. Every value below is optional; defaults work offline
# once the Hugging Face models have been downloaded once.
# =============================================================================

# ---- Hardware ---------------------------------------------------------------
# auto = MPS (Apple Silicon) > CUDA > CPU.  Force with: mps | cuda | cpu
DEVICE=auto

# auto     = use the Hugging Face models, fall back to lightweight methods if a model can't load
# fallback = never load transformer models (VADER + keyword/TF-IDF only; fast, lower accuracy)
ML_BACKEND=auto

# ---- Model configuration (Hugging Face repo id OR a local directory path) ----
SENTIMENT_BACKEND=auto                  # auto | roberta | vader
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
TIER1_BACKEND=auto                      # auto | zeroshot | keyword
ZERO_SHOT_MODEL=cross-encoder/nli-deberta-v3-small   # or facebook/bart-large-mnli
ZERO_SHOT_MIN_SCORE=0.30                # below this a review goes to "Other" (or the LLM, if enabled)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TIER2_BACKEND=auto                      # auto | bertopic | kmeans
SPACY_MODEL=en_core_web_sm

# Tier-1 taxonomy (comma separated). Leave empty for the 5 defaults.
CATEGORIES=

# Models are cached in feedback-analyzer/model/ by default.
# After the first successful run, uncomment to forbid any network access:
# HF_HUB_OFFLINE=1

# ---- Taxonomy / output tuning ------------------------------------------------
MIN_THEME_SIZE=5
MAX_SUBTOPICS_PER_CLASS=8
MAX_THEMES=25
SAMPLES_PER_THEME=5
BERTOPIC_MIN_DOCS=300                   # smaller groups use k-means (BERTopic needs enough data)
BATCH_SIZE=32

# ---- Sentiment label thresholds (polarity in -1..+1) -------------------------
POSITIVE_THRESHOLD=0.25
NEGATIVE_THRESHOLD=-0.25
STRONG_NEGATIVE_THRESHOLD=-0.60

# ---- PII ----------------------------------------------------------------------
# Regex always runs. spaCy NER additionally redacts PERSON names (can over-redact
# product/channel names, so it is off by default).
ENABLE_SPACY_NER=false

# ---- Drift ---------------------------------------------------------------------
# Baseline embeddings for drift. If the file doesn't exist, the first batch you analyze is
# saved here as the baseline (status "Baseline initialized"); later batches are compared to it.
# Replace it deliberately with:  python -m src.ml.pipeline --input good_period.csv --save-baseline
BASELINE_PATH=data/baseline_embeddings.npz

# ---- OPTIONAL: LLM-assisted labeling (OFF by default) --------------------------
# When enabled, an LLM (a) classifies reviews the zero-shot model is unsure about and
# (b) rewrites cluster names into readable titles. Only PII-redacted text is sent.
ENABLE_LLM_ASSIST=false
LLM_PROVIDER=auto                       # auto | openai | huggingface
LLM_MAX_CALLS=200                       # hard cap per run (cost control)

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Also used by transformers/huggingface_hub for authenticated model downloads
# (higher rate limits, gated models), even when LLM assist is disabled.
HUGGINGFACE_HUB_TOKEN=
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
